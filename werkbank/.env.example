# Kopieren nach .env und ausfüllen. Die .env NIE ins Git-Repo oder in einen Chat.

# Langes Zufallspasswort für App und Kurzbefehl. Erzeugen mit:
#   python3 -c "import secrets; print(secrets.token_urlsafe(32))"
API_TOKEN=

# Von console.anthropic.com (API-Guthaben, getrennt vom Claude-Abo).
# Leer lassen = Einträge landen in der Inbox, außer sie beginnen mit "ToDo:" oder "Gedanke:".
ANTHROPIC_API_KEY=

# Günstiges, schnelles Modell reicht zum Sortieren
CLAUDE_MODEL=claude-haiku-4-5-20251001
PRICE_INPUT_PER_MTOK=1
PRICE_OUTPUT_PER_MTOK=5

# Unter diesem Wert landet ein Eintrag zur Prüfung in der Inbox
CONFIDENCE_THRESHOLD=0.6

BASE_CURRENCY=EUR
PRICE_TTL_MINUTES=15
DB_PATH=data/brain.db
