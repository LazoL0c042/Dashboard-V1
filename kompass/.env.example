# Kompass – Konfiguration. Kopieren nach .env und ausfüllen.
# Datenbank
KOMPASS_DB=data/kompass.db
# Cookie nur über HTTPS senden (hinter tailscale serve: true, lokal zum Testen: false)
COOKIE_SECURE=true

# Kostenlose Modell-Zugänge (mindestens zwei verschiedene eintragen, besser alle)
# Groq:       https://console.groq.com/keys
GROQ_API_KEY=
# Mistral:    https://console.mistral.ai/api-keys  (Plan "Experiment" ist kostenlos)
MISTRAL_API_KEY=
# OpenRouter: https://openrouter.ai/keys  (nur Modelle mit ":free")
OPENROUTER_API_KEY=
# Cerebras:   https://cloud.cerebras.ai
CEREBRAS_API_KEY=
# Google Gemini: https://aistudio.google.com/apikey (Gratis-Stufe in der EU vorher prüfen)
GEMINI_API_KEY=

# Bundestag DIP (Gesetzgebung). Öffentlicher Schlüssel steht auf
# https://dip.bundestag.de/über-dip/hilfe/api  (wird jährlich erneuert)
DIP_API_KEY=
